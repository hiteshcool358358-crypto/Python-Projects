    "import sympy as sp\n",
    "\n",
    "#declaring variables for the algebraic expression\n",
    "x = sp.Symbol(\"x\")\n",
    "\n",
    "#let the expression be (x+1/x+1)^3\n",
    "exp = (x+1/x+1)**3\n",
    "\n",
    "#expansion\n",
    "print(sp.expand(exp))"
   ]
  }
